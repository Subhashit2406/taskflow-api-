# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskflow_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=2000

# Authentication & Security
JWT_SECRET=supersecretjwtkey_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d
API_KEY=taskflow_live_api_key_demo_secret_2026

# Cache Configuration
CACHE_TTL_SECONDS=60
ENABLE_CACHE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
